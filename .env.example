# Copy to .env locally. Never commit the real file.

# OpenAI-compatible endpoint. Default is a local freewhirr proxy.
SHIPWATCH_BASE_URL=http://127.0.0.1:8787/v1
SHIPWATCH_MODEL=freewhirr
SHIPWATCH_API_KEY=not-used

# Direct OpenRouter:
# SHIPWATCH_BASE_URL=https://openrouter.ai/api/v1
# SHIPWATCH_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_API_KEY=

# Direct OpenAI:
# SHIPWATCH_BASE_URL=https://api.openai.com/v1
# SHIPWATCH_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Optional: higher GitHub Releases quota
# GITHUB_TOKEN=
